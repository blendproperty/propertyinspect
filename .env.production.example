# Copy to .env.production on the VPS. Never commit the real file.
POSTGRES_PASSWORD=choose-a-long-random-password
# Keep true when the site is served over HTTPS (recommended). Set false only for a quick HTTP test.
COOKIE_SECURE=true
# Quick preview without a domain: uncomment both lines, then open http://<vps-ip>:3000
# APP_BIND=3000
# COOKIE_SECURE=false
